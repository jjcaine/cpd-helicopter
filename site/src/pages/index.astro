---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroStats from '../components/HeroStats.astro';
import stats from '../data/stats.json';
import histogram from '../data/histogram.json';

const totalFlightHours = histogram.reduce((sum: number, d: {hour: number, flights: number}) => sum + d.flights, 0);
const windDown = histogram.filter((d: {hour: number}) => d.hour >= 19 && d.hour <= 21).reduce((sum: number, d: {flights: number}) => sum + d.flights, 0);
const sleepHours = histogram.filter((d: {hour: number}) => d.hour >= 22 || d.hour <= 4).reduce((sum: number, d: {flights: number}) => sum + d.flights, 0);
const windDownPct = Math.round((windDown / totalFlightHours) * 100);
const sleepPct = Math.round((sleepHours / totalFlightHours) * 100);
---

<BaseLayout>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-inner">
      <div class="hero-grid">
        <div class="hero-headline">
          <span class="hero-eyebrow">Cleveland Police Helicopter Tracker</span>
          <h1>How often do Cleveland police helicopters fly?</h1>
        </div>
        <div class="hero-quote">
          <blockquote>
            We've been tracking since August 2025. So far: <strong>{stats.total_flights}</strong> flights in <strong>{stats.total_days}</strong> days. <strong>{windDownPct + sleepPct}%</strong> happened after 7&nbsp;PM.
          </blockquote>
        </div>
      </div>
      {stats.date_start && stats.date_end && (
        <p class="hero-date-range">
          Based on {stats.total_flights} flights tracked from {stats.date_start} to {stats.date_end}.
        </p>
      )}
    </div>
  </section>

  <!-- ============ DASHBOARD: 3 / 6 / 3 ============ -->
  <section class="dashboard">
    <div class="dashboard-inner">
      <div class="dashboard-grid">
        <!-- LEFT COL: stat cards stacked -->
        <div class="dashboard-left">
          <HeroStats
            totalFlights={stats.total_flights}
            totalDays={stats.total_days}
            costEstimateLow={stats.cost_estimate_low}
            costEstimateHigh={stats.cost_estimate_high}
            totalHours={stats.total_hours}
            pctAfter7pm={windDownPct + sleepPct}
          />
        </div>

        <!-- CENTER COL: map -->
        <div class="dashboard-center">
          <div class="panel-header">
            <h2>Where they fly</h2>
            <p>Flight paths plotted on the map, based on public transponder data.</p>
          </div>
          <div class="chart-container chart-container--map" id="flight-map"></div>
        </div>

        <!-- RIGHT COL: calendar + histogram stacked -->
        <div class="dashboard-right">
          <div class="right-panel">
            <div class="panel-header">
              <h2>When they fly</h2>
              <p>Every day, colored by hours of helicopter activity.</p>
            </div>
            <div class="chart-container" id="calendar-chart"></div>
          </div>
          <div class="right-panel">
            <div class="panel-header">
              <h2>What time</h2>
              <p>Most flights happen in the evening and at night.</p>
            </div>
            <div class="time-stats">
              <div class="time-stat">
                <span class="time-stat-number">{windDownPct}%</span>
                <span class="time-stat-label">wind-down hours <span class="time-stat-range">7–10 PM</span></span>
              </div>
              <div class="time-stat">
                <span class="time-stat-number">{sleepPct}%</span>
                <span class="time-stat-label">sleeping hours <span class="time-stat-range">10 PM–5 AM</span></span>
              </div>
            </div>
            <div class="chart-container" id="histogram-chart"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CONTENT SECTION ============ -->
  <section class="content-section">
    <div class="content-inner">
      <div class="content-grid">
        <div class="content-editorial">
          <h2>Why this matters</h2>
          <p>
            Cleveland spent <strong>$3.5 million</strong> to refurbish two police helicopters.
            They fly on more than half of all days, often circling over residential neighborhoods
            during evening and nighttime hours.
          </p>
          <p>
            At ground level, these helicopters produce approximately <strong>82 dB</strong> of noise.
            The World Health Organization recommends a nighttime limit of <strong>40 dB</strong>.
            Peer-reviewed research links this level of noise exposure to sleep disruption,
            cardiovascular harm, and impacts on children's learning.
          </p>
        </div>
        <div class="content-cta-cards">
          <div class="content-cta-card">
            <span class="cta-eyebrow">Learn more</span>
            <h3>Read the research</h3>
            <p>
              See what peer-reviewed studies say about helicopter noise,
              health impacts, and whether patrols actually reduce crime.
            </p>
            <a href="/research/" class="cta-button">Read the research &rarr;</a>
          </div>
          <div class="content-cta-card">
            <span class="cta-eyebrow">Do something</span>
            <h3>Here's what you can do</h3>
            <p>
              Call 311, contact your council member, and share the data.
              Every call gets logged. Numbers add up.
            </p>
            <a href="/action/" class="cta-button">Take action &rarr;</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import { renderCalendarChart } from '../lib/calendar-chart';
  import calendarData from '../data/calendar.json';

  const calendarEl = document.getElementById('calendar-chart');
  if (calendarEl) renderCalendarChart(calendarEl, calendarData);
</script>

<script>
  import { renderHistogramChart } from '../lib/histogram-chart';
  import histogramData from '../data/histogram.json';

  const histogramEl = document.getElementById('histogram-chart');
  if (histogramEl) renderHistogramChart(histogramEl, histogramData);
</script>

<script>
  import { renderFlightMap } from '../lib/flight-map';
  import hexData from '../data/hex-map.json';

  const mapEl = document.getElementById('flight-map');
  if (mapEl) renderFlightMap(mapEl, hexData);
</script>

<style>
  /* ============ HERO ============ */
  .hero {
    background-color: var(--color-surface-1);
    padding: var(--space-3xl) var(--space-xl) var(--space-2xl);
  }

  .hero-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
    align-items: start;
  }

  .hero-eyebrow {
    display: block;
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-primary);
    margin-bottom: var(--space-md);
  }

  .hero h1 {
    font-family: var(--font-heading);
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .hero-quote {
    background-color: var(--color-surface-2);
    border-left: 4px solid var(--color-primary);
    padding: var(--space-lg);
  }

  .hero-quote blockquote {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-style: italic;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  .hero-quote blockquote strong {
    color: var(--color-text);
    font-style: normal;
  }

  .hero-date-range {
    font-size: 0.8125rem;
    color: var(--color-text-muted);
    margin-top: var(--space-lg);
  }

  @media (min-width: 768px) {
    .hero {
      padding: var(--space-4xl) var(--space-xl) var(--space-2xl);
    }

    .hero-grid {
      grid-template-columns: 8fr 4fr;
      gap: var(--space-2xl);
    }

    .hero h1 {
      font-size: 3.5rem;
    }
  }

  /* ============ DASHBOARD ============ */
  .dashboard {
    background-color: var(--color-bg);
    padding: var(--space-2xl) var(--space-xl) var(--space-3xl);
  }

  .dashboard-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .dashboard-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  .dashboard-left {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .dashboard-center {
    min-width: 0;
  }

  .dashboard-right {
    display: flex;
    flex-direction: column;
    gap: var(--space-xl);
  }

  .right-panel {
    /* no extra styling needed, just a grouping wrapper */
  }

  .panel-header h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .panel-header p {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .chart-container {
    margin-top: var(--space-md);
  }

  .chart-container--map {
    position: relative;
    background-color: var(--color-surface-1);
    height: 400px;
  }

  .time-stats {
    display: flex;
    gap: var(--space-lg);
    margin-top: var(--space-md);
    flex-wrap: wrap;
  }

  .time-stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .time-stat-number {
    font-family: var(--font-heading);
    font-size: 2rem;
    font-weight: 700;
    color: var(--color-primary);
    line-height: 1;
  }

  .time-stat-label {
    font-size: 0.8125rem;
    color: var(--color-text-secondary);
  }

  .time-stat-range {
    color: var(--color-text-muted);
    font-size: 0.75rem;
  }

  @media (min-width: 1024px) {
    .dashboard-grid {
      grid-template-columns: 3fr 6fr 3fr;
      gap: var(--space-xl);
    }

    .chart-container--map {
      height: 700px;
    }
  }

  @media (min-width: 768px) and (max-width: 1023px) {
    .dashboard-grid {
      grid-template-columns: 1fr 1fr;
    }

    .dashboard-center {
      grid-column: 1 / -1;
      order: -1;
    }

    .chart-container--map {
      height: 500px;
    }
  }

  /* ============ CONTENT SECTION ============ */
  .content-section {
    background-color: var(--color-surface-1);
    padding: var(--space-3xl) var(--space-xl);
  }

  .content-inner {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  .content-editorial h2 {
    font-size: 1.75rem;
    margin-bottom: var(--space-md);
  }

  .content-editorial p {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .content-editorial p strong {
    color: var(--color-text);
  }

  .content-cta-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  .content-cta-card {
    background-color: var(--color-surface-2);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .cta-eyebrow {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--color-primary);
  }

  .content-cta-card h3 {
    font-size: 1.5rem;
    font-weight: 700;
  }

  .content-cta-card p {
    font-size: 0.9375rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .cta-button {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    background-color: var(--color-primary);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    transition: opacity 0.15s ease;
    align-self: flex-start;
  }

  .cta-button:hover {
    opacity: 0.9;
    color: #fff;
  }

  @media (min-width: 768px) {
    .content-section {
      padding: var(--space-3xl);
    }

    .content-grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }
</style>
