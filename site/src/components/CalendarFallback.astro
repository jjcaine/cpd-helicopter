---
interface CalendarEntry {
  date: string;
  hours: number;
  flights: number;
}

const { data } = Astro.props as { data: CalendarEntry[] };
const firstDate = new Date(`${data[0]?.date ?? '1970-01-04'}T00:00:00Z`);
const startDate = new Date(firstDate);
startDate.setUTCDate(firstDate.getUTCDate() - firstDate.getUTCDay());
const maxHours = Math.max(...data.map((entry) => entry.hours), 1);

const days = data.map((entry) => {
  const date = new Date(`${entry.date}T00:00:00Z`);
  const week = Math.floor((date.getTime() - startDate.getTime()) / 604_800_000) + 1;
  return {
    ...entry,
    intensity: Math.max(0.18, entry.hours / maxHours),
    weekday: date.getUTCDay() + 1,
    week,
  };
});
const totalWeeks = Math.max(...days.map((day) => day.week), 1);
---

<ol
  class="calendar-fallback"
  aria-label="Daily helicopter activity calendar"
  style={`--calendar-weeks: ${totalWeeks};`}
>
  {days.map((day) => (
    <li
      class="calendar-fallback-cell"
      data-chart-mark="calendar-day"
      data-date={day.date}
      aria-label={`${day.date}: ${day.hours.toFixed(1)} hours, ${day.flights} ${day.flights === 1 ? 'flight' : 'flights'}`}
      style={`--activity-intensity: ${day.intensity}; --week: ${day.week}; --weekday: ${day.weekday};`}
    ></li>
  ))}
</ol>

<style>
  .calendar-fallback {
    display: grid;
    grid-template-columns: repeat(var(--calendar-weeks), minmax(4px, 1fr));
    grid-template-rows: repeat(7, 10px);
    gap: 1px;
    min-width: 0;
    padding: 2px;
    overflow-x: auto;
  }

  .calendar-fallback-cell {
    grid-column: var(--week);
    grid-row: var(--weekday);
    min-width: 8px;
    min-height: 10px;
    background: var(--color-primary);
    border-radius: 2px;
    opacity: var(--activity-intensity);
  }
</style>
