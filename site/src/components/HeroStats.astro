---
interface Props {
  totalFlights: number;
  totalDays: number;
  costEstimateLow: number;
  costEstimateHigh: number;
  totalHours: number;
  pctAfter7pm: number;
}

const { totalFlights, totalDays, costEstimateLow, costEstimateHigh, totalHours, pctAfter7pm } = Astro.props;

function formatNumber(n: number): string {
  return n.toLocaleString('en-US');
}

const annualLow = Math.round((costEstimateLow / totalDays) * 365 / 1000);
const annualHigh = Math.round((costEstimateHigh / totalDays) * 365 / 1000);
---

<div class="stat-stack">
  <div class="stat-card">
    <span class="stat-category">Refurbishment cost</span>
    <span class="stat-number">$3.5M</span>
    <span class="stat-desc">taxpayer money for two helicopters</span>
  </div>
  <div class="stat-card">
    <span class="stat-category">Total flights</span>
    <span class="stat-number">{formatNumber(totalFlights)}</span>
    <span class="stat-desc">in the last {totalDays} days</span>
  </div>
  <div class="stat-card">
    <span class="stat-category">Night flights</span>
    <span class="stat-number">{pctAfter7pm}%</span>
    <span class="stat-desc">of flights happen after 7 PM</span>
  </div>
  <div class="stat-card">
    <span class="stat-category">Noise level</span>
    <span class="stat-number">~82 dB</span>
    <span class="stat-desc">at ground level</span>
    <span class="stat-cite"><a href="/research/#health">WHO safe limit is 40 dB &rarr;</a></span>
  </div>
  <div class="stat-card stat-card--muted">
    <span class="stat-category">Annual operating cost</span>
    <span class="stat-number stat-number--sm">${annualLow}K–${annualHigh}K</span>
    <span class="stat-desc">estimated per year in fuel, maintenance, and crew — based on {formatNumber(totalHours)} flight hours at $200–$400/hr</span>
  </div>
</div>

<style>
  .stat-stack {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .stat-card {
    background-color: var(--color-surface-4);
    padding: var(--space-xl);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .stat-category {
    font-family: var(--font-body);
    font-size: 10px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-text-muted);
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 3rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-primary);
  }

  .stat-number--sm {
    font-size: 2rem;
  }

  .stat-desc {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 400;
    color: var(--color-text-secondary);
    line-height: 1.4;
  }

  .stat-card--muted .stat-desc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  .stat-cite {
    font-size: 0.75rem;
    font-style: italic;
    margin-top: var(--space-xs);
  }

  .stat-cite a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .stat-cite a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }
</style>
