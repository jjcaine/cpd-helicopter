---
interface Props {
  totalFlights: number;
  totalDays: number;
  costEstimateLow: number;
  costEstimateHigh: number;
  totalHours: number;
  pctAfter7pm: number;
}

const { totalFlights, totalDays, costEstimateLow, costEstimateHigh, totalHours, pctAfter7pm } = Astro.props;

function formatNumber(n: number): string {
  return n.toLocaleString('en-US');
}

const annualLow = Math.round((costEstimateLow / totalDays) * 365 / 1000);
const annualHigh = Math.round((costEstimateHigh / totalDays) * 365 / 1000);
---

<div class="hero-stats">
  <div class="stat-card">
    <span class="stat-number">$3.5M</span>
    <span class="stat-label">taxpayer money to refurbish two helicopters</span>
  </div>
  <div class="stat-card">
    <span class="stat-number">{formatNumber(totalFlights)}</span>
    <span class="stat-label">flights in the last {totalDays} days</span>
  </div>
  <div class="stat-card">
    <span class="stat-number">{pctAfter7pm}%</span>
    <span class="stat-label">of flights happen after 7 PM</span>
  </div>
  <div class="stat-card">
    <span class="stat-number">~82 dB</span>
    <span class="stat-label">noise at ground level</span>
    <span class="stat-cite"><a href="/research/#health">The WHO says 40 dB is the safe limit for nighttime →</a></span>
  </div>
</div>
<p class="cost-context">
  On top of the $3.5M refurbishment, operating costs run an estimated
  <strong>${annualLow}K–${annualHigh}K per year</strong> in fuel, maintenance,
  and crew — based on {formatNumber(totalHours)} flight hours tracked over {totalDays} days
  at industry rates of $200–$400/hour.
</p>

<style>
  .hero-stats {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
    padding: var(--space-xl) 0;
  }

  .stat-card {
    background-color: var(--color-surface-1);
    border: 1px solid var(--color-border);
    padding: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .stat-number {
    font-family: var(--font-heading);
    font-size: 2.5rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-primary);
  }

  .stat-label {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-text-secondary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .stat-cite {
    font-size: 0.75rem;
    font-style: italic;
    text-transform: none;
    letter-spacing: 0;
    margin-top: 0.25rem;
  }

  .stat-cite a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .stat-cite a:hover {
    color: var(--color-primary);
    text-decoration: underline;
  }

  .cost-context {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    max-width: 48rem;
  }

  .cost-context strong {
    color: var(--color-text-secondary);
  }

  @media (min-width: 640px) {
    .hero-stats {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .hero-stats {
      grid-template-columns: repeat(4, 1fr);
    }

    .stat-number {
      font-size: 3rem;
    }
  }
</style>
